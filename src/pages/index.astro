		padding: 0.5em;
		font-size: 0.85em;
		color: rgb(var(--gray));
		text-align: center;
	}

	.lightbox {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 9999;
		background: rgba(0, 0, 0, 0.85);
		justify-content: center;
		align-items: center;
	}
	.lightbox.active {
		display: flex;
	}
	.lightbox img {
		max-width: 90vw;
		max-height: 90vh;
		border-radius: 4px;
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
	}
	.lightbox-close {
		position: absolute;
		top: 1em;
		right: 1.5em;
		font-size: 2.5em;
		color: #fff;
		cursor: pointer;
		line-height: 1;
		z-index: 10000;
	}
	.lightbox-close:hover {
