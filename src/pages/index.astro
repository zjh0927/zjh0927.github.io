	}

	.gallery {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 1em;
		margin: 1em 0;
	}
	.gallery figure {
		margin: 0;
		border: 1px solid rgba(var(--gray), 0.2);
		border-radius: 6px;
		overflow: hidden;
		background: #fff;
		cursor: pointer;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
