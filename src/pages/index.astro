	}

	.skills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
	}
	.skill-tag {
		background: rgba(var(--accent), 0.1);
		color: var(--accent);
		padding: 0.3em 0.8em;
		border-radius: 20px;
		font-size: 0.9em;
	}
</style>
