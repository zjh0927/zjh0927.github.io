---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

import imgObsViz from '../assets/projects/障碍物识别-可视化.png';
import imgObsReal from '../assets/projects/障碍物识别-实物.jpg';
import imgLowObsViz from '../assets/projects/低矮可跨域障碍物识别-可视化.png';
import imgLowObsReal from '../assets/projects/低矮可跨域障碍物识别-实物.jpg';
import imgTraversable from '../assets/projects/可通行区域可视化.png';
import imgVoronoiFramework from '../assets/projects/维诺图自主探索导航算法框架.png';
import imgVoronoiReal from '../assets/projects/实机维诺图探索可视化.png';
import imgExplorationResult from '../assets/projects/全局探索结果.png';
import imgVideoStream from '../assets/projects/多路视频传输可视化.png';
import imgPortrait from '../assets/projects/zjh证件照.jpg';
import imgGraduation from '../assets/projects/zjh本科毕业照.jpg';
import imgSoftwareCert from '../assets/projects/基于自组网的室内机器人远距离通信软件.png';
import imgOriginal1 from '../assets/projects/1.jpg';
import imgBlurred1 from '../assets/projects/1_blurred3.jpg';
import imgDeblurred1 from '../assets/projects/1_deblurred3.jpg';
import imgDetOrig1 from '../assets/projects/1_detection.jpg';
import imgDetBlurred1 from '../assets/projects/eval1_blurred3_detection.jpg';
import imgDetDeblurred1 from '../assets/projects/eval1_deblurred3_detection.jpg';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-top">
					<Image class="portrait" src={imgPortrait} alt="证件照" />
					<h1>曾家豪 <span class="name-en">Zeng Jiahao</span></h1>
				</div>
				<p class="tagline">机器人感知 / SLAM / 导航</p>
				<p class="intro">
					北京航空航天大学 机器人工程 硕士研究生。
				</p>
				<p class="intro">
					研究方向为机器人感知与导航，包括 SLAM、自主探索、路径规划与嵌入式系统部署。
				</p>
				<p class="contact">
					<span>📍 北京</span>
					<span>📧 3083448680@qq.com</span>
					<span>📱 191-1889-2896</span>
				</p>
			</section>

			<section>
				<h2>教育经历</h2>
				<div class="edu-item">
					<div class="edu-header">
						<strong>北京航空航天大学</strong>
						<span class="edu-meta">机器人工程 · 硕士 | 2024.09 – 2027.06</span>
					</div>
					<p>GPA 3.66/4.0 | 深度学习及应用 (94)、空间机构与现代机器人学 (90)、单片机系统 (95)、矩阵理论 (94)</p>
					<p>Y709-1 研究生党支部书记，2026 年校级优秀学生干部</p>
				</div>
				<div class="edu-item">
					<div class="edu-header">
						<strong>福州大学</strong>
						<span class="edu-meta">机械设计制造及其自动化 · 本科 | 2020.09 – 2024.06</span>
					</div>
					<p>GPA 前 30% | 机器人学、机器视觉及应用、微机原理、C++ 程序设计、控制工程基础、机电装备设计</p>
					<Image class="graduation-photo" src={imgGraduation} alt="本科毕业照" />
				</div>
			</section>

			<section>
				<h2>实习经历</h2>
				<div class="edu-item">
					<div class="edu-header">
						<strong>歌尔股份有限公司（Goertek）· Alpha Lab</strong>
						<span class="edu-meta">北京 | 2026.07 – 至今</span>
					</div>
					<ul>
						<li>复现 <strong>UMI</strong> 数据采集与处理管线，完成 zarr / LeRobot 等多格式数据集转换，满足不同模型训练需求</li>
						<li>基于 <strong>Pinocchio</strong> 刚体动力学库搭建天机双臂机器人运动学与动力学模型，并使用 <strong>OCS2</strong> 最优控制框架，通过 <strong>NMPC</strong> 求解双臂协调运动的关节力矩，实现轨迹跟踪与柔顺控制</li>
						<li>参与开源 <strong>VLA 模型</strong>微调，预计实现双臂机器人长时间序列的精细操作</li>
					</ul>
				</div>
			</section>

			<section>
				<h2>项目经历</h2>

				<div class="project-item">
					<h3>灭火、救援机器人共性关键技术研究（国家重点研发计划）<span class="project-date">2024.10 – 至今</span></h3>

					<div class="project-sub">
						<h4>SLAM 定位</h4>
						<p>基于 FAST-LIO 和 FAST-LIO2 算法，引入 <strong>OctVox 紧凑地图结构</strong>与 <strong>HKNN 启发式 KNN 搜索策略</strong>，在保证 LIO 系统定位精度的前提下减少计算开销，避免在 ARM 平台（Jetson 系列）上抢占过多用于导航和视觉检测的算力。在无回环检测情况下，实现长距离（&gt;100m）定位精度 &lt;15cm。</p>
					</div>

					<div class="project-sub">
						<h4>障碍物识别与避障</h4>
						<p>基于 Nav2 开源导航框架改进 TEB 避障算法，引入路径平滑度与曲率约束作为 g2o 图的边（edge），同时采用 <strong>时空体素层</strong>（STVL, Spatio Temporal Voxel Layer）作为 Nav2 的局部代价地图，引导障碍物识别、避障与穿越规划。使用 Livox-mid70 小视场角激光雷达与 USB 工业广角相机，实现了实机动态避障、越障和穿越。</p>
						<div class="gallery">
							<figure>
								<Image src={imgObsViz} alt="障碍物识别可视化" />
								<figcaption>障碍物识别可视化</figcaption>
							</figure>
							<figure>
								<Image src={imgObsReal} alt="障碍物识别实拍" />
								<figcaption>障碍物识别实拍</figcaption>
							</figure>
							<figure>
								<Image src={imgLowObsViz} alt="低矮可跨域障碍物识别可视化" />
								<figcaption>低矮可跨域障碍物识别</figcaption>
							</figure>
							<figure>
								<Image src={imgLowObsReal} alt="低矮可跨域障碍物识别实拍" />
								<figcaption>越障识别实拍</figcaption>
							</figure>
							<figure>
								<Image src={imgTraversable} alt="可通行区域可视化" />
								<figcaption>可通行区域可视化</figcaption>
							</figure>
						</div>
					</div>

					<div class="project-sub">
						<h4>自主探索</h4>
						<p>基于 <strong>动态维诺图</strong>并在 Nav2 导航框架上开发自主探索器：实时构建二维栅格地图，并在其上构建动态维诺骨架图，针对 Livox-mid70 小视场角激光雷达优化前沿点和导航点的选取，融合 YOLO 目标检测算法寻找目标物体。成功实现 30m×30m 未知室内环境下的 <strong>物体目标导航</strong>（Object-Goal Nav），预计产出论文一篇。</p>
						<div class="gallery">
							<figure>
								<Image src={imgVoronoiFramework} alt="维诺图自主探索导航算法框架" />
								<figcaption>维诺图探索算法框架</figcaption>
							</figure>
							<figure>
								<Image src={imgVoronoiReal} alt="实机维诺图探索可视化" />
								<figcaption>实机维诺图探索</figcaption>
							</figure>
							<figure>
								<Image src={imgExplorationResult} alt="全局探索结果" />
								<figcaption>全局探索结果</figcaption>
							</figure>
						</div>
						<div class="video-wrapper">
							<iframe
								src="//player.bilibili.com/player.html?bvid=BV1AyNJ6kEJx&autoplay=0"
								scrolling="no"
								border="0"
								frameborder="no"
								framespacing="0"
								allowfullscreen="true"
								loading="lazy"
							></iframe>
						</div>
					</div>

					<div class="project-sub">
						<h4>视频传输</h4>
						<p>基于 FFmpeg 实现 USB 工业相机实时视频流编码，编码格式为 H.265，传输所需带宽相比原始 MJPEG 格式仅为约 5%，相比 H.264 可再压缩约 50%，即一路 1280×720 @30fps 的视频流可压缩至 <strong>1Mbps 以内</strong>。实现了长距离、窄带宽、高波动的无线 mesh 组网下的多路视频流收发。已申请软著一项。</p>
						<div class="gallery">
							<figure>
								<Image src={imgVideoStream} alt="多路视频传输可视化" />
								<figcaption>多路 H.265 视频传输</figcaption>
							</figure>
							<figure>
								<Image src={imgSoftwareCert} alt="基于自组网的室内机器人远距离通信软件" />
								<figcaption>软件著作权：基于自组网的室内机器人远距离通信软件</figcaption>
							</figure>
						</div>
					</div>
				</div>

				<div class="project-item">
					<h3>聚变堆遥操作维护重载臂底盘系统（国家重大科技基础设施项目）<span class="project-date">2024.11 – 2026.06</span></h3>
					<p class="project-desc">面向聚变反应堆内部操作维护需求，研发遥操作重载机械臂底盘运动系统，实现超重型机械臂的平稳运动行进与位置锁定。</p>
					<ul>
						<li>采用倍福 PLC 作为主控，基于 <strong>TwinCAT 3 + ST 结构化文本</strong>开发，设计多层状态机</li>
						<li>采用 <strong>PLCopen 运动控制规范</strong>实现 8 轴 EtherCAT 伺服同步控制与安全联锁</li>
						<li>设计并搭建 <strong>ADS 上位机通信 UI 界面</strong>，与倍福 PLC 之间实现并发同步通信</li>
					</ul>
				</div>

				<div class="project-item">
					<h3>视频图像去模糊 <span class="project-date">2024.11 – 2025.06</span></h3>
					<p class="project-desc">面向存在高频抖动下的场景（无人机或其他高速运动场景），开发图像模糊评价体系和去模糊算法，解决画面模糊导致的识别检测失效问题。</p>
					<ul>
						<li>基于 <strong>DeblurGANv2</strong> 改进开发，针对高频真实抖动产生的运动模糊图像，设计对抗生成网络去模糊算法</li>
						<li>SSIM/PSNR 等传统指标平均提升 10%，总体评价指标提升近 40%，YOLO 目标检测成功率显著提升</li>
						<li>使用 <strong>TensorRT</strong> 进行模型加速，在 Jetson Orin NX 上实现实时视频流去模糊（&gt;30fps）</li>
					</ul>
					<div class="gallery">
						<figure>
							<Image src={imgOriginal1} alt="原始清晰图像" />
							<figcaption>原始清晰图像</figcaption>
						</figure>
						<figure>
							<Image src={imgBlurred1} alt="仿运动模糊图像" />
							<figcaption>运动模糊图像</figcaption>
						</figure>
						<figure>
							<Image src={imgDeblurred1} alt="去模糊结果" />
							<figcaption>去模糊结果</figcaption>
						</figure>
					</div>
					<div class="gallery">
						<figure>
							<Image src={imgDetOrig1} alt="原始图像检测结果" />
							<figcaption>原始图像 YOLO 检测</figcaption>
						</figure>
						<figure>
							<Image src={imgDetBlurred1} alt="模糊图像检测结果" />
							<figcaption>模糊图像 YOLO 检测（漏检/误检）</figcaption>
						</figure>
						<figure>
							<Image src={imgDetDeblurred1} alt="去模糊后检测结果" />
							<figcaption>去模糊后 YOLO 检测（恢复）</figcaption>
						</figure>
					</div>
				</div>

				<div class="project-item">
					<h3>移动作业机器人运动控制研究（本科毕业设计）<span class="project-date">2023.11 – 2024.05</span></h3>
					<p class="project-desc">针对移动机器人运动规划需求，设计整体运动规划方法，编写 ROS 控制程序，完成仿真与实机实验。</p>
					<ul>
						<li>对经典 RRT 算法及其改进算法进行原理分析，将 <strong>Informed-RRT* 算法</strong>编写为 ROS 导航全局规划插件</li>
						<li>搭建 Gazebo 仿真环境测试全局路径规划算法，实机使用 <strong>Gmapping / Cartographer</strong> 建图并实现运动规划导航</li>
						<li>设计 Rviz 上位机控制机械臂进行抓取作业</li>
					</ul>
				</div>
			</section>

			<section>
				<h2>技能</h2>
				<div class="skills">
					<span class="skill-tag">ROS2 / ROS</span>
					<span class="skill-tag">C++ / Python</span>
					<span class="skill-tag">FFmpeg</span>
					<span class="skill-tag">PyTorch</span>
					<span class="skill-tag">传感器标定</span>
					<span class="skill-tag">嵌入式开发 (Jetson)</span>
					<span class="skill-tag">Nav2 导航框架</span>
					<span class="skill-tag">SLAM</span>
					<span class="skill-tag">TensorRT</span>
				</div>
			</section>
		</main>

		<div id="lightbox" class="lightbox">
			<span class="lightbox-close">&times;</span>
			<img id="lightbox-img" src="" alt="" />
		</div>

		<Footer />
	</body>
</html>

<script>
	const lightbox = document.getElementById('lightbox');
	const lightboxImg = document.getElementById('lightbox-img');
	const closeBtn = document.querySelector('.lightbox-close');

	document.querySelectorAll('.gallery figure img').forEach(img => {
		img.addEventListener('click', () => {
			lightboxImg.src = img.src;
			lightboxImg.alt = img.alt;
			lightbox.classList.add('active');
			document.body.style.overflow = 'hidden';
		});
	});

	function closeLightbox() {
		lightbox.classList.remove('active');
		document.body.style.overflow = '';
	}

	closeBtn.addEventListener('click', closeLightbox);
	lightbox.addEventListener('click', (e) => {
		if (e.target === lightbox) closeLightbox();
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') closeLightbox();
	});
</script>

<style>
	.hero {
		text-align: center;
		padding: 3em 0 2em;
	}
	.hero-top {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.5em;
		flex-wrap: wrap;
	}
	.hero-top h1 {
		margin: 0;
		line-height: 1.2;
	}
	.portrait {
		width: 100px;
		height: 130px;
		object-fit: cover;
		border-radius: 4px;
	}
	.hero h1 {
		font-size: 2.5em;
		margin-bottom: 0.2em;
	}
	.name-en {
		font-weight: 400;
		font-size: 0.5em;
		color: rgb(var(--gray));
		display: block;
	}
	.tagline {
		font-size: 1.3em;
		color: var(--accent);
		margin-bottom: 0.8em;
	}
	.intro {
		max-width: 700px;
		margin: 0 auto 0.3em;
		color: rgb(var(--gray-dark));
		line-height: 1.8;
	}
	.contact {
		display: flex;
		justify-content: center;
		gap: 1.5em;
		flex-wrap: wrap;
		color: rgb(var(--gray));
		font-size: 0.95em;
	}

	section {
		max-width: 900px;
		margin: 0 auto 3em;
	}
	section h2 {
		border-bottom: 2px solid var(--accent);
		padding-bottom: 0.3em;
		margin-bottom: 1em;
	}

	.edu-item {
		margin-bottom: 1.5em;
	}
	.edu-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		flex-wrap: wrap;
		margin-bottom: 0.3em;
	}
	.edu-meta {
		color: rgb(var(--gray));
		font-size: 0.9em;
	}
	.graduation-photo {
		width: 100%;
		max-width: 400px;
		border-radius: 6px;
		margin-top: 0.8em;
	}

	.project-item {
		margin-bottom: 2em;
	}
	.project-item h3 {
		font-size: 1.1em;
		margin-bottom: 0.5em;
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		flex-wrap: wrap;
	}
	.project-date {
		color: rgb(var(--gray));
		font-size: 0.85em;
		font-weight: 400;
	}
	.project-item ul {
		margin: 0;
		padding-left: 1.2em;
	}
	.project-item li {
		margin-bottom: 0.3em;
		line-height: 1.7;
	}
	.project-desc {
		color: rgb(var(--gray-dark));
		margin-bottom: 0.5em;
		line-height: 1.7;
	}

	.video-wrapper {
		position: relative;
		padding-bottom: 56.25%;
		height: 0;
		margin: 1em 0;
		overflow: hidden;
		border-radius: 6px;
	}
	.video-wrapper iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border: none;
	}

	.project-sub {
		margin-bottom: 1.5em;
	}
	.project-sub h4 {
		font-size: 1em;
		margin-bottom: 0.3em;
	}
	.project-sub p {
		margin-bottom: 0.6em;
		color: rgb(var(--gray-dark));
